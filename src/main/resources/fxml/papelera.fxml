<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="12"
      styleClass="content"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.misgastos.controller.PapeleraController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="table-card" style="-fx-padding: 16;">

        <Label text="🗑 Papelera de gastos"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <Label text="Los gastos eliminados quedan aquí. Puedes restaurarlos o borrarlos de forma definitiva."
               style="-fx-text-fill: #64748b;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="↩ Restaurar" styleClass="primary-button" onAction="#handleRestaurar"/>
            <Button text="✖ Eliminar definitivamente" styleClass="secondary-button" onAction="#handleEliminarDefinitivo"/>
            <Button text="🧹 Vaciar papelera" styleClass="secondary-button" onAction="#handleVaciar"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblResumen" text="" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        </HBox>

        <TableView fx:id="tablaPapelera" VBox.vgrow="ALWAYS" style="-fx-fixed-cell-size: 34px;">
            <columns>
                <TableColumn fx:id="colEliminado" text="Eliminado el" prefWidth="130" minWidth="120"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="95" minWidth="90"/>
                <TableColumn fx:id="colHora" text="Hora" prefWidth="65" minWidth="60"/>
                <TableColumn fx:id="colUsuario" text="Registrado por" prefWidth="120" minWidth="110"/>
                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="140" minWidth="120"/>
                <TableColumn fx:id="colProducto" text="Producto" prefWidth="170" minWidth="140"/>
                <TableColumn fx:id="colCedula" text="Cédula" prefWidth="110" minWidth="100"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150" minWidth="120"/>
                <TableColumn fx:id="colCantidad" text="Cant." prefWidth="65" minWidth="60"/>
                <TableColumn fx:id="colTotal" text="Total" prefWidth="110" minWidth="100"/>
            </columns>
        </TableView>

    </VBox>
</VBox>
