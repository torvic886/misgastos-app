<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="12" style="-fx-padding: 0;" styleClass="content, gasto-screen"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.misgastos.controller.PapeleraController">

	<VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="table-card">

		<!-- ============ ENCABEZADO + ACCIONES ============ -->
		<HBox spacing="10" alignment="CENTER_LEFT" styleClass="panel-header">
			<Label styleClass="icon-circle">
				<graphic>
					<SVGPath styleClass="icon-white"
						content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
				</graphic>
			</Label>
			<VBox spacing="2">
				<Label text="Papelera de gastos" styleClass="panel-title" />
				<Label
					text="Los gastos eliminados quedan aquí. Puedes restaurarlos o borrarlos de forma definitiva."
					styleClass="panel-subtitle" />
			</VBox>

			<Region HBox.hgrow="ALWAYS" />

			<Button text="Restaurar" onAction="#handleRestaurar"
				styleClass="toolbar-button, toolbar-blue">
				<graphic>
					<Group>
						<SVGPath styleClass="toolbar-icon" scaleX="0.75" scaleY="0.75"
							content="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" />
					</Group>
				</graphic>
			</Button>
			<Button text="Eliminar definitivamente"
				onAction="#handleEliminarDefinitivo"
				styleClass="toolbar-button, toolbar-red">
				<graphic>
					<Group>
						<SVGPath styleClass="toolbar-icon" scaleX="0.75" scaleY="0.75"
							content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zm2.46-7.12l1.41-1.41L12 12.59l2.12-2.12 1.41 1.41L13.41 14l2.12 2.12-1.41 1.41L12 15.41l-2.12 2.12-1.41-1.41L10.59 14l-2.13-2.12zM15.5 4l-1-1h-5l-1 1H5v2h14V4z" />
					</Group>
				</graphic>
			</Button>
			<Button text="Vaciar papelera" onAction="#handleVaciar"
				styleClass="toolbar-button, toolbar-neutral">
				<graphic>
					<Group>
						<SVGPath styleClass="toolbar-icon" scaleX="0.75" scaleY="0.75"
							content="M15 16h4v2h-4zm0-8h7v2h-7zm0 4h6v2h-6zM3 18c0 1.1.9 2 2 2h6c1.1 0 2-.9 2-2V8H3v10zM14 5h-3l-1-1H6L5 5H2v2h12z" />
					</Group>
				</graphic>
			</Button>
		</HBox>

		<!-- ============ TABLA ============ -->
		<TableView fx:id="tablaPapelera" VBox.vgrow="ALWAYS"
			style="-fx-fixed-cell-size: 34px;">
			<columnResizePolicy>
				<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
			</columnResizePolicy>
			<columns>
				<TableColumn fx:id="colEliminado" text="Eliminado el"
					prefWidth="130" minWidth="120" />
				<TableColumn fx:id="colFecha" text="Fecha" prefWidth="95"
					minWidth="90" />
				<TableColumn fx:id="colHora" text="Hora" prefWidth="65"
					minWidth="60" />
				<TableColumn fx:id="colUsuario" text="Registrado por"
					prefWidth="120" minWidth="110" />
				<TableColumn fx:id="colCategoria" text="Categoría"
					prefWidth="140" minWidth="120" />
				<TableColumn fx:id="colProducto" text="Producto"
					prefWidth="170" minWidth="140" />
				<TableColumn fx:id="colCedula" text="Cédula" prefWidth="110"
					minWidth="100" />
				<TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"
					minWidth="120" />
				<TableColumn fx:id="colCantidad" text="Cant." prefWidth="65"
					minWidth="60" />
				<TableColumn fx:id="colTotal" text="Total" prefWidth="110"
					minWidth="100" />
			</columns>
			<placeholder>
				<VBox alignment="CENTER" spacing="8">
					<SVGPath styleClass="icon-empty"
						content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
					<Label text="La papelera está vacía" styleClass="rep-empty-title" />
				</VBox>
			</placeholder>
		</TableView>

		<!-- ============ RESUMEN ============ -->
		<HBox spacing="10" alignment="CENTER_LEFT" styleClass="pager-bar">
			<Label fx:id="lblResumen" text="" styleClass="pager-label" />
		</HBox>

	</VBox>
</VBox>
