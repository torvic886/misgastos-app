<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.misgastos.controller.ModalNovedadController"
        styleClass="content, gasto-screen" prefWidth="460" prefHeight="580">

        <VBox spacing="10" styleClass="form-card" VBox.vgrow="ALWAYS">

                <HBox spacing="10" alignment="CENTER_LEFT"
                        styleClass="panel-header">
                        <Label styleClass="icon-circle">
                                <graphic>
                                        <SVGPath styleClass="icon-white"
                                                content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
                                </graphic>
                        </Label>
                        <VBox spacing="2">
                                <Label fx:id="lblTitulo" text="Nueva novedad"
                                        styleClass="panel-title" />
                                <Label text="Incapacidades, permisos, vacaciones, faltas y notas"
                                        styleClass="panel-subtitle" />
                        </VBox>
                </HBox>

                <VBox spacing="4" styleClass="form-fields">
                        <Label text="Tipo:" styleClass="form-label" />
                        <ComboBox fx:id="cmbTipo" maxWidth="Infinity" promptText="Elija el tipo" />

                        <Label text="Empleado:" styleClass="form-label, campo-sep" />
                        <ComboBox fx:id="cmbEmpleado" maxWidth="Infinity" promptText="Elija el empleado" />

                        <VBox fx:id="boxSegunda" spacing="4" managed="false" visible="false">
                                <Label text="Segunda persona (cambio de turno):" styleClass="form-label, campo-sep" />
                                <ComboBox fx:id="cmbEmpleado2" maxWidth="Infinity" promptText="Elija la otra persona" />
                        </VBox>

                        <HBox spacing="10">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Desde:" styleClass="form-label, campo-sep" />
                                        <DatePicker fx:id="dpDesde" maxWidth="Infinity" />
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Hasta:" styleClass="form-label, campo-sep" />
                                        <DatePicker fx:id="dpHasta" maxWidth="Infinity" />
                                </VBox>
                        </HBox>
                        <Label fx:id="lblDias" text="" styleClass="form-hint" />

                        <Label text="Motivo (opcional, máximo 300 caracteres):" styleClass="form-label, campo-sep" />
                        <TextArea fx:id="txtMotivo" wrapText="true" prefRowCount="3"
                                promptText="Ej: Incapacidad por gripa" />
                </VBox>

                <Label fx:id="lblError" text="" styleClass="error-message"
                        managed="false" visible="false" wrapText="true" />

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="10" alignment="CENTER">
                        <Button text="Cancelar" styleClass="btn-limpiar"
                                onAction="#handleCancelar" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <graphic>
                                        <SVGPath styleClass="icon-slate"
                                                content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                </graphic>
                        </Button>
                        <Button text="Guardar" styleClass="btn-guardar"
                                onAction="#handleGuardar" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <graphic>
                                        <SVGPath styleClass="icon-white"
                                                content="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" />
                                </graphic>
                        </Button>
                </HBox>

        </VBox>
</VBox>