<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.misgastos.controller.ModalTurnoController"
        styleClass="content, gasto-screen" prefWidth="460" prefHeight="660">

        <fx:define>
                <ToggleGroup fx:id="grupoTipo" />
        </fx:define>

        <VBox spacing="10" styleClass="form-card" VBox.vgrow="ALWAYS">

                <HBox spacing="10" alignment="CENTER_LEFT"
                        styleClass="panel-header">
                        <Label styleClass="icon-circle">
                                <graphic>
                                        <SVGPath styleClass="icon-white"
                                                content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" />
                                </graphic>
                        </Label>
                        <VBox spacing="2">
                                <Label fx:id="lblTitulo" text="Nuevo turno"
                                        styleClass="panel-title" />
                                <Label text="Horario y cupos del turno" styleClass="panel-subtitle" />
                        </VBox>
                </HBox>

                <VBox spacing="4" styleClass="form-fields">
                        <Label text="Tipo de turno:" styleClass="form-label" />
                        <HBox spacing="16" alignment="CENTER_LEFT">
                                <RadioButton fx:id="rbCompleto" text="Turno completo"
                                        toggleGroup="$grupoTipo" selected="true" />
                                <RadioButton fx:id="rbMedio" text="Medio turno"
                                        toggleGroup="$grupoTipo" />
                        </HBox>

                        <Label text="Nombre:" styleClass="form-label, campo-sep" />
                        <TextField fx:id="txtNombre" styleClass="search-field" />

                        <Label text="Hora de inicio:" styleClass="form-label, campo-sep" />
                        <ComboBox fx:id="cmbHoraInicio" editable="true"
                                maxWidth="Infinity" visibleRowCount="8" />

                        <Label text="Hora de fin:" styleClass="form-label, campo-sep" />
                        <ComboBox fx:id="cmbHoraFin" editable="true"
                                maxWidth="Infinity" visibleRowCount="8" />

                        <Label text="Personas por día:" styleClass="form-label, campo-sep" />
                        <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button text="−" styleClass="toolbar-button, toolbar-neutral"
                                        onAction="#handleMenosCupos" />
                                <Label fx:id="lblCupos" text="1"
                                        style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-min-width: 24; -fx-alignment: CENTER;" />
                                <Button text="+" styleClass="toolbar-button, toolbar-neutral"
                                        onAction="#handleMasCupos" />
                        </HBox>

                        <Label fx:id="lblResumen" text="" wrapText="true"
                                style="-fx-font-weight: bold; -fx-padding: 8 0 0 0;" />

                        <VBox fx:id="boxEspeciales" spacing="4" style="-fx-padding: 8 0 0 0;">
                                <Label text="Horarios especiales (solo si este turno cambia de horario):"
                                        styleClass="form-label" wrapText="true" />

                                <HBox spacing="8" alignment="CENTER_LEFT">
                                        <CheckBox fx:id="chkSabado" text="Sábado" minWidth="130" />
                                        <ComboBox fx:id="cmbSabadoInicio" editable="true"
                                                prefWidth="95" visibleRowCount="8" />
                                        <Label text="a" />
                                        <ComboBox fx:id="cmbSabadoFin" editable="true"
                                                prefWidth="95" visibleRowCount="8" />
                                </HBox>
                                <Label fx:id="lblResumenSabado" text="" wrapText="true"
                                        style="-fx-text-fill: #5B6378; -fx-font-size: 12px;" />

                                <HBox spacing="8" alignment="CENTER_LEFT">
                                        <CheckBox fx:id="chkDomingo" text="Dom. o festivo" minWidth="130" />
                                        <ComboBox fx:id="cmbDomingoInicio" editable="true"
                                                prefWidth="95" visibleRowCount="8" />
                                        <Label text="a" />
                                        <ComboBox fx:id="cmbDomingoFin" editable="true"
                                                prefWidth="95" visibleRowCount="8" />
                                </HBox>
                                <Label fx:id="lblResumenDomingo" text="" wrapText="true"
                                        style="-fx-text-fill: #5B6378; -fx-font-size: 12px;" />
                        </VBox>

                        <CheckBox fx:id="chkActivo" text="Turno activo"
                                managed="false" visible="false" />
                </VBox>

                <Label fx:id="lblError" text="" styleClass="error-message"
                        managed="false" visible="false" wrapText="true" />

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="10" alignment="CENTER">
                        <Button text="Cancelar" styleClass="btn-limpiar"
                                onAction="#handleCancelar" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <graphic>
                                        <SVGPath styleClass="icon-slate"
                                                content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                                </graphic>
                        </Button>
                        <Button text="Guardar" styleClass="btn-guardar"
                                onAction="#handleGuardar" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <graphic>
                                        <SVGPath styleClass="icon-white"
                                                content="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" />
                                </graphic>
                        </Button>
                </HBox>

        </VBox>
</VBox>