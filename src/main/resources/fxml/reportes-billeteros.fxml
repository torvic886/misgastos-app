<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.misgastos.controller.ReportesBilleterosController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
            style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="12" styleClass="content">
        <padding>
            <Insets top="16" right="20" bottom="16" left="20"/>
        </padding>

        <!-- Encabezado con los totales a la derecha -->
        <HBox styleClass="header-box" alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 10 16;">
            <Label text="📊" style="-fx-font-size: 20px;"/>
            <VBox spacing="0">
                <Label text="Reportes de Billeteros" styleClass="section-title"/>
                <Label text="Genera reportes completos con análisis financiero detallado"
                       styleClass="caption"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="20" alignment="CENTER_RIGHT">
                <VBox spacing="0" alignment="CENTER_RIGHT">
                    <Label text="Total Billetero" styleClass="caption"/>
                    <Label fx:id="lblTotalBilletero" text="0.00"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                </VBox>
                <Separator orientation="VERTICAL"/>
                <VBox spacing="0" alignment="CENTER_RIGHT">
                    <Label text="Total Premios" styleClass="caption"/>
                    <Label fx:id="lblTotalPremios" text="0.00"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                </VBox>
                <Separator orientation="VERTICAL"/>
                <VBox spacing="0" alignment="CENTER_RIGHT">
                    <Label text="Utilidad Total" styleClass="caption"/>
                    <Label fx:id="lblUtilidadTotal" text="0.00"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- Generadores de reportes -->
        <HBox spacing="12">

            <!-- Reporte mensual -->
            <VBox styleClass="form-card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="400"
                  style="-fx-padding: 12 16;">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="📅" style="-fx-font-size: 16px;"/>
                    <VBox spacing="0">
                        <Label text="Reporte Mensual"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1e293b;"/>
                        <Label text="Agrupa datos por mes con totales acumulados" styleClass="caption"/>
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Fecha inicio" styleClass="form-label"/>
                        <DatePicker fx:id="dpMensualInicio" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Fecha fin" styleClass="form-label"/>
                        <DatePicker fx:id="dpMensualFin" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="8">
                    <Button text="👁 Vista previa" onAction="#handleVistaPreviaMensual"
                            styleClass="search-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="📊 Excel" onAction="#handleMensualExcel"
                            styleClass="secondary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="📄 PDF" onAction="#handleMensualPDF"
                            styleClass="danger-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>

            <!-- Reporte diario -->
            <VBox styleClass="form-card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="400"
                  style="-fx-padding: 12 16;">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="📆" style="-fx-font-size: 16px;"/>
                    <VBox spacing="0">
                        <Label text="Reporte Diario"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1e293b;"/>
                        <Label text="Detalle día por día con utilidades" styleClass="caption"/>
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Fecha inicio" styleClass="form-label"/>
                        <DatePicker fx:id="dpDiarioInicio" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Fecha fin" styleClass="form-label"/>
                        <DatePicker fx:id="dpDiarioFin" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="8">
                    <Button text="👁 Vista previa" onAction="#handleVistaPreviaDiario"
                            styleClass="search-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="📊 Excel" onAction="#handleDiarioExcel"
                            styleClass="secondary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="📄 PDF" onAction="#handleDiarioPDF"
                            styleClass="danger-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Vista previa: ocupa todo el espacio que sobra -->
        <VBox styleClass="table-card" spacing="8" VBox.vgrow="ALWAYS"
              style="-fx-padding: 12 16;">

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="📊" style="-fx-font-size: 16px;"/>
                <VBox spacing="0" HBox.hgrow="ALWAYS">
                    <Label text="Vista previa del reporte"
                           style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1e293b;"/>
                    <Label fx:id="lblRangoFechas"
                           text="Seleccione fechas y presione 'Vista Previa' para generar el reporte"
                           styleClass="caption"/>
                </VBox>
                <Button text="🔄 Limpiar" onAction="#handleLimpiarVista" styleClass="neutral-button"/>
            </HBox>

            <!-- Sin ScrollPane propio: así el encabezado de la tabla queda fijo -->
            <TableView fx:id="tblVistaPrevia" styleClass="tabla-reporte"
                       minHeight="260" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colPeriodo" text="Periodo" prefWidth="90" minWidth="80"/>
                    <TableColumn fx:id="colBilletero" text="Acum. Billetero" prefWidth="115" minWidth="90"/>
                    <TableColumn fx:id="colPremios" text="Acum. Premios" prefWidth="115" minWidth="90"/>
                    <TableColumn fx:id="colDiferencia" text="Diferencia" prefWidth="105" minWidth="85"/>
                    <TableColumn fx:id="colGastosLocal" text="Gastos Local" prefWidth="105" minWidth="85"/>
                    <TableColumn fx:id="colPagosManuel" text="Pagos Manuel" prefWidth="105" minWidth="85"/>
                    <TableColumn fx:id="colInversion" text="Inversión" prefWidth="100" minWidth="80"/>
                    <TableColumn fx:id="colGastoTotal" text="Gasto Total" prefWidth="105" minWidth="85"/>
                    <TableColumn fx:id="colUtilidadNeta" text="Utilidad Neta" prefWidth="110" minWidth="90"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="6">
                        <Label text="No hay datos para mostrar"/>
                        <Label text="Seleccione un rango de fechas y presione 'Vista previa'"
                               styleClass="caption"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>