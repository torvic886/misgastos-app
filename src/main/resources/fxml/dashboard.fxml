<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane fx:id="mainBorderPane" prefWidth="1200"
	prefHeight="700" xmlns="http://javafx.com/javafx/17"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.misgastos.controller.DashboardController">

	<top>
		<HBox styleClass="top-bar" spacing="15" alignment="CENTER_LEFT">

			<Label text="💰 ExpenseFlow" styleClass="title" />

			<Region HBox.hgrow="ALWAYS" />

			<HBox styleClass="user-info-container" spacing="10"
				alignment="CENTER">
				<Label fx:id="lblAvatar" styleClass="user-avatar" text="A" />

				<VBox spacing="2" alignment="CENTER_LEFT">
					<Label fx:id="lblUsuarioNombre" styleClass="user-name"
						text="admin" />
					<Label fx:id="lblUsuarioRol" styleClass="user-role"
						text="ADMINISTRADOR" />
				</VBox>
			</HBox>

			<Region styleClass="top-bar-separator" prefWidth="1"
				prefHeight="30" />

			<Button text="🚪 Cerrar Sesión" onAction="#handleCerrarSesion" />

		</HBox>
	</top>

	<left>
		<ScrollPane fx:id="sidebarScroll" fitToWidth="true"
			fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
			style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
			<VBox fx:id="sidebar" styleClass="sidebar" spacing="2">

				<Button fx:id="btnToggleMenu" text="Menú"
					styleClass="menu-button, menu-toggle" onAction="#handleToggleMenu"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
					</graphic>
				</Button>

				<Label fx:id="lblGrupoGastos" text="GASTOS"
					styleClass="sidebar-group" />

				<Button fx:id="btnInicio" text="Inicio"
					styleClass="menu-button" onAction="#handleInicio"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
					</graphic>
				</Button>

				<Button fx:id="btnGastos" text="Mis Gastos"
					styleClass="menu-button" onAction="#handleGastos"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" />
					</graphic>
				</Button>

				<Button fx:id="btnInformes" text="Informes"
					styleClass="menu-button" onAction="#handleInformes"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" />
					</graphic>
				</Button>

				<Button fx:id="btnConsultas" text="Consultas"
					styleClass="menu-button" onAction="#handleConsultas"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
					</graphic>
				</Button>

				<Label fx:id="lblGrupoPersonas" text="PERSONAS"
					styleClass="sidebar-group" />

				<Button fx:id="btnUsuarios" text="Usuarios"
					styleClass="menu-button" onAction="#handleUsuarios"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
					</graphic>
				</Button>

				<Button fx:id="btnClientes" text="Clientes"
					styleClass="menu-button" onAction="#handleClientes"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M20 0H4v2h16V0zM4 24h16v-2H4v2zM20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-8 2.75c1.24 0 2.25 1.01 2.25 2.25s-1.01 2.25-2.25 2.25S9.75 10.24 9.75 9 10.76 6.75 12 6.75zM17 17H7v-1.5c0-1.67 3.33-2.5 5-2.5s5 .83 5 2.5V17z" />
					</graphic>
				</Button>

				<Button fx:id="btnBilleteros" text="Billeteros"
					styleClass="menu-button" onAction="#handleBilleteros"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" />
					</graphic>
				</Button>

				<Button fx:id="btnReportesBilleteros"
					text="Reportes Billeteros" styleClass="menu-button"
					onAction="#handleReportesBilleteros" maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
					</graphic>
				</Button>

				<Label fx:id="lblGrupoSistema" text="SISTEMA"
					styleClass="sidebar-group" />

				<Button fx:id="btnPresupuestos" text="Presupuestos"
					styleClass="menu-button" onAction="#handlePresupuestos"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M11 2v20c-5.07-.5-9-4.79-9-10s3.93-9.5 9-10zm2.03 0v8.99H22c-.47-4.74-4.24-8.52-8.97-8.99zm0 11.01V22c4.74-.47 8.5-4.25 8.97-8.99h-8.97z" />
					</graphic>
				</Button>

				<Button fx:id="btnRegistroCambios" text="Registro de cambios"
					styleClass="menu-button" onAction="#handleRegistroCambios"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" />
					</graphic>
				</Button>

				<Button fx:id="btnCorregirDatos" text="Corregir datos"
					styleClass="menu-button" onAction="#handleCorregirDatos"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
					</graphic>
				</Button>

				<Button fx:id="btnRespaldo" text="Respaldo"
					styleClass="menu-button" onAction="#handleRespaldo"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" />
					</graphic>
				</Button>

				<Button fx:id="btnDiagnostico" text="Diagnóstico y registros"
					styleClass="menu-button" onAction="#handleDiagnostico"
					maxWidth="Infinity">
					<graphic>
						<SVGPath styleClass="menu-icon"
							content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" />
					</graphic>
				</Button>

			</VBox>
		</ScrollPane>
	</left>

	<center>
		<VBox styleClass="content" alignment="CENTER" spacing="20">
			<Label text="Bienvenido a ExpenseFlow"
				styleClass="content-title" />
			<Label text="Selecciona una opción del menú para comenzar"
				styleClass="content-subtitle" />
			<padding>
				<Insets top="20" right="20" bottom="20" left="20" />
			</padding>
		</VBox>
	</center>

</BorderPane>