<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/17"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.misgastos.controller.ModalEmpleadoController"
	styleClass="content, gasto-screen" prefWidth="420" prefHeight="470">

	<VBox spacing="10" styleClass="form-card" VBox.vgrow="ALWAYS">

		<HBox spacing="10" alignment="CENTER_LEFT"
			styleClass="panel-header">
			<Label styleClass="icon-circle">
				<graphic>
					<SVGPath styleClass="icon-white"
						content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
				</graphic>
			</Label>
			<VBox spacing="2">
				<Label fx:id="lblTitulo" text="Nuevo empleado"
					styleClass="panel-title" />
				<Label text="Datos del empleado" styleClass="panel-subtitle" />
			</VBox>
		</HBox>

		<VBox spacing="4" styleClass="form-fields">
			<Label text="Nombre:" styleClass="form-label" />
			<TextField fx:id="txtNombre"
				promptText="Ej: Katherine López" styleClass="search-field" />

			<CheckBox fx:id="chkEncargada" text="Es encargada de turno" />

			<Label text="Fecha de ingreso:"
				styleClass="form-label, campo-sep" />
			<DatePicker fx:id="dpIngreso" maxWidth="Infinity" />

			<Label text="Fecha de retiro:"
				styleClass="form-label, campo-sep" />
			<DatePicker fx:id="dpRetiro" maxWidth="Infinity" />
			<Label
				text="Déjala vacía si sigue trabajando. Para reactivar a alguien, bórrala."
				wrapText="true" styleClass="form-hint" />
		</VBox>

		<Label fx:id="lblError" text="" styleClass="error-message"
			managed="false" visible="false" wrapText="true" />

		<Region VBox.vgrow="ALWAYS" />

		<HBox spacing="10" alignment="CENTER">
			<Button text="Cancelar" styleClass="btn-limpiar"
				onAction="#handleCancelar" HBox.hgrow="ALWAYS" maxWidth="Infinity">
				<graphic>
					<SVGPath styleClass="icon-slate"
						content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
				</graphic>
			</Button>
			<Button text="Guardar" styleClass="btn-guardar"
				onAction="#handleGuardar" HBox.hgrow="ALWAYS" maxWidth="Infinity">
				<graphic>
					<SVGPath styleClass="icon-white"
						content="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" />
				</graphic>
			</Button>
		</HBox>

	</VBox>
</VBox>