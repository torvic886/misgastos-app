<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.misgastos.controller.DiagnosticoController"
            fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="12" styleClass="content">
        <padding>
            <Insets top="20" right="24" bottom="20" left="24"/>
        </padding>

        <!-- Encabezado -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <StackPane minWidth="44" minHeight="44" prefWidth="44" prefHeight="44">
                <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"
                         fill="#2563eb" scaleX="1.5" scaleY="1.5"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="Diagnóstico y registros"
                       style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1e293b;"/>
                <Label text="Consulta los registros del sistema y revisa posibles errores o advertencias."
                       wrapText="true"
                       style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
            </VBox>
        </HBox>

        <!-- Filtros -->
        <VBox styleClass="form-card">
            <FlowPane hgap="12" vgap="8" alignment="BOTTOM_LEFT" rowValignment="BOTTOM">
                <VBox spacing="4">
                    <Label text="Nivel de log" styleClass="form-label"/>
                    <ComboBox fx:id="cmbNivel" prefWidth="110"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Archivo" styleClass="form-label"/>
                    <ComboBox fx:id="cmbArchivo" prefWidth="210"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Buscar" styleClass="form-label"/>
                    <TextField fx:id="txtBuscar" promptText="Buscar palabra clave..." prefWidth="220"
                               onAction="#handleActualizar"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Desde" styleClass="form-label"/>
                    <DatePicker fx:id="dpDesde" prefWidth="140"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Hasta" styleClass="form-label"/>
                    <DatePicker fx:id="dpHasta" prefWidth="140"/>
                </VBox>
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#handleActualizar"
                        styleClass="search-button"/>
            </FlowPane>
        </VBox>

        <!-- Tabla + detalles (altura fija: el scroll de la pantalla se encarga del resto) -->
        <HBox spacing="12" minHeight="380" prefHeight="380">
            <VBox styleClass="table-card" spacing="8" HBox.hgrow="ALWAYS" minWidth="360">
                <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No hay registros con esos filtros"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colFecha" text="Fecha y hora" prefWidth="140" minWidth="120"/>
                        <TableColumn fx:id="colNivel" text="Nivel" prefWidth="70" minWidth="64"/>
                        <TableColumn fx:id="colClase" text="Clase" prefWidth="160" minWidth="100"/>
                        <TableColumn fx:id="colMensaje" text="Mensaje" prefWidth="300"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnAnterior" text="‹ Anterior" onAction="#handleAnterior"
                            styleClass="neutral-button"/>
                    <Label fx:id="lblPagina" text="Página 1 de 1"
                           style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
                    <Button fx:id="btnSiguiente" text="Siguiente ›" onAction="#handleSiguiente"
                            styleClass="neutral-button"/>
                    <ProgressIndicator fx:id="progreso" prefWidth="22" prefHeight="22" visible="false"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Más recientes primero" styleClass="caption"/>
                </HBox>
            </VBox>

            <VBox styleClass="form-card" spacing="6" prefWidth="320" minWidth="300" maxWidth="340">
                <Label text="Detalles del registro"
                       style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1e293b;"/>

                <Label text="Fecha y hora" styleClass="log-field-label"/>
                <Label fx:id="lblDetalleFecha" styleClass="log-detail-value"/>

                <Label text="Nivel" styleClass="log-field-label"/>
                <HBox>
                    <Label fx:id="lblDetalleNivel" styleClass="label, log-badge"/>
                </HBox>

                <Label text="Clase" styleClass="log-field-label"/>
                <Label fx:id="lblDetalleClase" wrapText="true" styleClass="log-detail-value"/>

                <Label text="Mensaje" styleClass="log-field-label"/>
                <TextArea fx:id="txtMensaje" editable="false" wrapText="true" prefRowCount="3"
                          styleClass="log-text-area"/>

                <Label text="Excepción y traza técnica" styleClass="log-field-label"/>
                <TextArea fx:id="txtTraza" editable="false" wrapText="false" VBox.vgrow="ALWAYS"
                          styleClass="log-text-area, log-trace-area"/>

                <HBox spacing="8">
                    <Button fx:id="btnCopiar" text="Copiar error" onAction="#handleCopiar"
                            styleClass="neutral-button"/>
                    <Button fx:id="btnAbrirArchivo" text="Abrir archivo" onAction="#handleAbrirArchivo"
                            styleClass="neutral-button"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Pie: conteo, archivo consultado y acceso a la carpeta -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="lblResumen" wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Abrir carpeta de logs" onAction="#handleAbrirCarpeta"
                    styleClass="search-button"/>
        </HBox>
        
                <!-- Vista del archivo: últimas líneas, estilo consola -->
        <VBox styleClass="log-console">
            <HBox styleClass="log-console-tab-bar" alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblNombreVista" styleClass="log-console-tab" text="misgastos.log"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Últimas 200 líneas" styleClass="log-console-hint"/>
            </HBox>
            <TextArea fx:id="txtVista" editable="false" wrapText="false"
                      minHeight="220" prefHeight="220" styleClass="log-console-text"/>
        </VBox>

        <!-- Ubicación y límites -->
        <HBox spacing="12">
            <VBox styleClass="log-info-card" spacing="8" HBox.hgrow="ALWAYS" prefWidth="420">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <SVGPath content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                             fill="#2563eb"/>
                    <Label text="Ubicación recomendada"
                           style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1e293b;"/>
                </HBox>
                <Label text="Los logs se guardan en la carpeta:"
                       style="-fx-font-size: 12px; -fx-text-fill: #334155;"/>
                <Label fx:id="lblCarpeta" wrapText="true" styleClass="log-path"/>
                <Label wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #475569;"
                       text="Equivale a %USERPROFILE%\MisGastos\logs: en cada computador se calcula sola según el usuario de Windows. No requiere permisos de administrador y se conserva aunque reinstales el programa."/>
            </VBox>

            <VBox styleClass="form-card" spacing="6" HBox.hgrow="ALWAYS" prefWidth="420">
                <Label text="Límites y rotación"
                       style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1e293b;"/>
                <Label wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #475569;"
                       text="Tamaño máximo por archivo (10 MB): al llegar a ese tamaño, o a la medianoche, se archiva y se crea uno nuevo."/>
                <Label wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #475569;"
                       text="Historial (30 días): se conservan los archivos de los últimos 30 días."/>
                <Label wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #475569;"
                       text="Límite total (80 MB): máximo aproximado entre archivos archivados; el archivo activo puede sumar hasta 10 MB más."/>
                <Label wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #475569;"
                       text="Compresión (GZ) y limpieza automática: los archivos antiguos se comprimen y los que ya no corresponden se borran solos, también al iniciar el programa."/>
                <Label wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"
                       text="Si el programa falla antes de arrancar, el detalle queda en los archivos consola-AAAA-MM-DD.log de la misma carpeta."/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>