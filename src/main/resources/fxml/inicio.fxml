<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>

<ScrollPane fitToWidth="true"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.misgastos.controller.InicioController"
	style="-fx-background-color: #f1f5f9;">
	<VBox spacing="16" style="-fx-background-color: #f1f5f9;">
		<padding>
			<Insets top="20" right="20" bottom="20" left="20" />
		</padding>

		<!-- Encabezado más compacto -->
		<HBox fx:id="panelEncabezado" spacing="10"
			alignment="CENTER_LEFT"
			style="-fx-background-color: white; -fx-padding: 10 14; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-border-color: #cbd5e1; -fx-border-width: 1.5; -fx-border-radius: 12;">
			<Label text="📊" style="-fx-font-size: 20px;" />
			<VBox spacing="0">
				<Label text="Panel de Control"
					style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
				<Label text="Resumen de tus gastos y estadísticas"
					style="-fx-font-size: 10px; -fx-text-fill: #64748b;" />
			</VBox>
		</HBox>

		<!-- Presupuesto del mes: ocupa el lugar del encabezado cuando hay topes -->
		<VBox fx:id="panelPresupuestos" visible="false" managed="false"
			spacing="10" maxWidth="Infinity"
			style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-border-color: #cbd5e1; -fx-border-width: 1.5; -fx-border-radius: 12;">
			<HBox alignment="CENTER_LEFT" spacing="8">
				<Label text="💰" style="-fx-font-size: 20px;" />
				<Label text="Presupuesto del mes"
					style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
				<Region HBox.hgrow="ALWAYS" />
				<Label fx:id="lblPresupuestoResumen"
					style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
			</HBox>
			<Separator style="-fx-background-color: #e2e8f0;" />
			<FlowPane fx:id="flowPresupuestos" hgap="24" vgap="14" />
		</VBox>

		<!-- Tarjetas de indicadores - MÁS BAJAS -->
		<HBox spacing="12" alignment="CENTER" fillHeight="false">
			<!-- Tarjeta Hoy -->
			<VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS"
				prefHeight="70" maxWidth="Infinity"
				style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 8 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-border-color: #3b82f6; -fx-border-width: 0 0 3 0; -fx-border-radius: 12;">
				<HBox alignment="CENTER" spacing="4">
					<Label text="📅" style="-fx-font-size: 13px;" />
					<Label text="Hoy"
						style="-fx-font-size: 10px; -fx-font-weight: 600; -fx-text-fill: #64748b;" />
				</HBox>
				<Label fx:id="lblTotalHoy" text="0"
					style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
				<HBox fx:id="hboxCambioHoy" alignment="CENTER" spacing="2"
					style="-fx-background-color: #fee2e2; -fx-padding: 2 6; -fx-background-radius: 5;">
					<Label fx:id="lblCambioHoy" text="↑ 528,9%"
						style="-fx-font-size: 8px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" />
				</HBox>
			</VBox>

			<!-- Tarjeta Semana -->
			<VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS"
				prefHeight="70" maxWidth="Infinity"
				style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 8 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-border-color: #8b5cf6; -fx-border-width: 0 0 3 0; -fx-border-radius: 12;">
				<HBox alignment="CENTER" spacing="4">
					<Label text="📆" style="-fx-font-size: 13px;" />
					<Label text="Esta Semana"
						style="-fx-font-size: 10px; -fx-font-weight: 600; -fx-text-fill: #64748b;" />
				</HBox>
				<Label fx:id="lblTotalSemana" text="0"
					style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
				<HBox fx:id="hboxCambioSemana" alignment="CENTER" spacing="2"
					style="-fx-background-color: #d1fae5; -fx-padding: 2 6; -fx-background-radius: 5;">
					<Label fx:id="lblCambioSemana" text="↑ 12,3%"
						style="-fx-font-size: 8px; -fx-font-weight: bold; -fx-text-fill: #059669;" />
				</HBox>
			</VBox>

			<!-- Tarjeta Mes -->
			<VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS"
				prefHeight="70" maxWidth="Infinity"
				style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 8 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-border-color: #10b981; -fx-border-width: 0 0 3 0; -fx-border-radius: 12;">
				<HBox alignment="CENTER" spacing="4">
					<Label text="📊" style="-fx-font-size: 13px;" />
					<Label text="Este Mes"
						style="-fx-font-size: 10px; -fx-font-weight: 600; -fx-text-fill: #64748b;" />
				</HBox>
				<Label fx:id="lblTotalMes" text="0"
					style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
				<HBox fx:id="hboxCambioMes" alignment="CENTER" spacing="2"
					style="-fx-background-color: #fee2e2; -fx-padding: 2 6; -fx-background-radius: 5;">
					<Label fx:id="lblCambioMes" text="↑ 208,0%"
						style="-fx-font-size: 8px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" />
				</HBox>
			</VBox>

			<!-- Tarjeta Año -->
			<VBox spacing="3" alignment="CENTER" HBox.hgrow="ALWAYS"
				prefHeight="70" maxWidth="Infinity"
				style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 8 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-border-color: #f59e0b; -fx-border-width: 0 0 3 0; -fx-border-radius: 12;">
				<HBox alignment="CENTER" spacing="4">
					<Label text="📈" style="-fx-font-size: 13px;" />
					<Label text="Este Año"
						style="-fx-font-size: 10px; -fx-font-weight: 600; -fx-text-fill: #64748b;" />
				</HBox>
				<Label fx:id="lblTotalAnio" text="0"
					style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
				<HBox fx:id="hboxCambioAnio" alignment="CENTER" spacing="2"
					style="-fx-background-color: #d1fae5; -fx-padding: 2 6; -fx-background-radius: 5;">
					<Label fx:id="lblCambioAnio" text="↑ 97,0%"
						style="-fx-font-size: 8px; -fx-font-weight: bold; -fx-text-fill: #059669;" />
				</HBox>
			</VBox>
		</HBox>

		<!-- Gráficos mejorados con marcos - ANCHO COMPLETO -->
		<HBox spacing="14" alignment="CENTER" fillHeight="true">
			<!-- Gráfico de Barras -->
			<VBox spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity"
				style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-border-color: #cbd5e1; -fx-border-width: 1.5; -fx-border-radius: 12;">
				<HBox alignment="CENTER_LEFT" spacing="8">
					<Label text="📈" style="-fx-font-size: 20px;" />
					<Label text="Gastos últimos 7 días"
						style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
				</HBox>
				<Separator style="-fx-background-color: #e2e8f0;" />
				<BarChart fx:id="chartUltimosDias" legendVisible="false"
					animated="true" prefHeight="240" styleClass="bar-chart">
					<padding>
						<Insets top="10" right="15" bottom="10" left="5" />
					</padding>
					<xAxis>
						<CategoryAxis side="BOTTOM" tickLabelRotation="0" />
					</xAxis>
					<yAxis>
						<NumberAxis side="LEFT" label="Monto"
							autoRanging="true" tickLabelGap="8">
							<padding>
								<Insets right="10" />
							</padding>
						</NumberAxis>
					</yAxis>
				</BarChart>
			</VBox>

			<!-- Gráfico de Torta con leyenda lateral -->
			<VBox spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity"
				style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-border-color: #cbd5e1; -fx-border-width: 1.5; -fx-border-radius: 12;">
				<HBox alignment="CENTER_LEFT" spacing="8">
					<Label text="🍰" style="-fx-font-size: 20px;" />
					<Label text="Distribución por Categoría"
						style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
				</HBox>
				<Separator style="-fx-background-color: #e2e8f0;" />
				<HBox spacing="15" alignment="CENTER">
					<PieChart fx:id="chartCategorias" legendVisible="false"
						animated="true" prefHeight="200" prefWidth="200"
						labelLineLength="10" labelsVisible="false" styleClass="pie-chart" />
					<!-- Leyenda personalizada lateral derecha -->
					<VBox fx:id="vboxLeyendaCategorias" spacing="4"
						alignment="CENTER_LEFT" style="-fx-padding: 10;" />
				</HBox>
			</VBox>
		</HBox>

		<!-- Sección de detalles mejorada CON MARCOS - ANCHO COMPLETO -->
		<HBox spacing="14" alignment="CENTER" fillHeight="true">
			<!-- Top Productos CON MARCO -->
			<VBox spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity"
				style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-border-color: #cbd5e1; -fx-border-width: 1.5; -fx-border-radius: 12;">
				<HBox alignment="CENTER_LEFT" spacing="8">
					<Label text="🏆" style="-fx-font-size: 20px;" />
					<Label text="Top 5 Productos"
						style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
				</HBox>
				<Separator style="-fx-background-color: #e2e8f0;" />
				<VBox fx:id="vboxTopProductos" spacing="8" />
			</VBox>

			<!-- Por Categorías CON MARCO -->
			<VBox spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity"
				style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-border-color: #cbd5e1; -fx-border-width: 1.5; -fx-border-radius: 12;">
				<HBox alignment="CENTER_LEFT" spacing="8">
					<Label text="📂" style="-fx-font-size: 20px;" />
					<Label text="Resumen por Categoría"
						style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
				</HBox>
				<Separator style="-fx-background-color: #e2e8f0;" />
				<VBox fx:id="vboxCategorias" spacing="8" />
			</VBox>
		</HBox>


	</VBox>
</ScrollPane>