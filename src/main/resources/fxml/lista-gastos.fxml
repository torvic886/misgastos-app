<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="content" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.misgastos.controller.ListaGastosController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <children>
        <Label text="📋 Historial de Gastos" styleClass="content-title"/>
        <Label text="Visualiza y gestiona todos tus gastos registrados" styleClass="content-subtitle"/>

        <!-- Filtros de fecha para exportación -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="Fecha Inicio:"/>
            <DatePicker fx:id="dpFechaInicio" promptText="Desde..."/>
            <Label text="Fecha Fin:"/>
            <DatePicker fx:id="dpFechaFin" promptText="Hasta..."/>
            <Button text="📊 Exportar Excel" onAction="#handleExportarExcel" styleClass="primary-button"/>
        </HBox>

        <!-- Barra de búsqueda y acciones -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscar" promptText="🔍 Producto, categoría, cédula o nombre..." prefWidth="380" onAction="#handleBuscar"/>
            <Button text="Buscar" onAction="#handleBuscar" styleClass="primary-button"/>
            <Button text="🔄 Refrescar" onAction="#handleRefrescar" styleClass="secondary-button"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="✖ Eliminar" onAction="#handleEliminar" styleClass="danger-button"/>
        </HBox>

        <!-- Tabla de gastos -->
        <TableView fx:id="tableGastos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="65"/>
				<TableColumn fx:id="colFecha" text="Fecha" prefWidth="115"/>
				<TableColumn fx:id="colHora" text="Hora" prefWidth="90"/>
				<TableColumn fx:id="colUsuario" text="Registrado por" prefWidth="120"/>
				<TableColumn fx:id="colCategoria" text="Categoría" prefWidth="135"/>
				<TableColumn fx:id="colProducto" text="Producto" prefWidth="200"/>
				<TableColumn fx:id="colCedula" text="Cédula" prefWidth="120"/>
				<TableColumn fx:id="colNombre" text="Nombre" prefWidth="160"/>
				<TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="105"/>
				<TableColumn fx:id="colValorUnitario" text="Valor Unit." prefWidth="120"/>
				<TableColumn fx:id="colValorTotal" text="Total" prefWidth="110"/>
            </columns>
        </TableView>

        <!-- Total de los gastos que se muestran en la tabla -->
        <HBox alignment="CENTER_RIGHT">
            <Label fx:id="lblTotalGastos" text="TOTAL: $0" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
    </children>
</VBox>
