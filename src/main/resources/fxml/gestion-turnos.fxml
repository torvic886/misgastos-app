<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="12" style="-fx-padding: 0;"
	styleClass="content, gasto-screen" xmlns="http://javafx.com/javafx/17"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.misgastos.controller.GestionTurnosController">

	<!-- ============ ENCABEZADO ============ -->
	<HBox spacing="10" alignment="CENTER_LEFT" styleClass="table-card">
		<HBox spacing="10" alignment="CENTER_LEFT"
			styleClass="panel-header">
			<Label styleClass="icon-circle">
				<graphic>
					<SVGPath styleClass="icon-white"
						content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z" />
				</graphic>
			</Label>
			<VBox spacing="2">
				<Label text="Turnos" styleClass="panel-title" />
				<Label text="Empleados, turnos y festivos"
					styleClass="panel-subtitle" />
			</VBox>
		</HBox>
		<Region HBox.hgrow="ALWAYS" />
		<HBox fx:id="boxBotonesCalendario" spacing="10"
			alignment="CENTER_RIGHT">
			<Button text="◂ Anterior"
				styleClass="toolbar-button, toolbar-neutral"
				onAction="#handleCalAnterior" />
			<Button text="Este mes"
				styleClass="toolbar-button, toolbar-neutral"
				onAction="#handleCalEsteMes" />
			<Button text="Siguiente ▸"
				styleClass="toolbar-button, toolbar-neutral"
				onAction="#handleCalSiguiente" />
			<Button text="Actualizar"
				styleClass="toolbar-button, toolbar-neutral"
				onAction="#handleCalActualizar" />
			<Button text="Ingresar semana"
				styleClass="toolbar-button, toolbar-blue"
				onAction="#handleCalIngresarSemana" />
		</HBox>
	</HBox>

	<!-- ============ PESTAÑAS ============ -->
	<VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="table-card">
		<TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
			VBox.vgrow="ALWAYS">
			<tabs>
				<Tab fx:id="tabCalendario" text="Calendario">
					<content>
						<fx:include fx:id="calendario"
							source="calendario-turnos.fxml" />
					</content>
				</Tab>
				<Tab fx:id="tabEmpleados" text="Empleados">
					<content>
						<VBox spacing="8">
							<HBox spacing="10" alignment="CENTER_LEFT">
								<Region HBox.hgrow="ALWAYS" />
								<Button text="Nuevo empleado"
									styleClass="toolbar-button, toolbar-blue"
									onAction="#handleNuevoEmpleado">
									<graphic>
										<SVGPath styleClass="toolbar-icon"
											content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
									</graphic>
								</Button>
								<Button text="Actualizar"
									styleClass="toolbar-button, toolbar-neutral"
									onAction="#handleActualizarEmpleados">
									<graphic>
										<SVGPath styleClass="toolbar-icon"
											content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
									</graphic>
								</Button>
							</HBox>
							<TableView fx:id="tablaEmpleados" VBox.vgrow="ALWAYS">
								<columnResizePolicy>
									<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
								</columnResizePolicy>
								<columns>
									<TableColumn fx:id="colEmpNombre" text="Nombre"
										prefWidth="260" />
									<TableColumn fx:id="colEmpRol" text="Rol"
										prefWidth="110" />
									<TableColumn fx:id="colEmpIngreso" text="Ingreso"
										prefWidth="110" />
									<TableColumn fx:id="colEmpRetiro" text="Retiro"
										prefWidth="110" />
									<TableColumn fx:id="colEmpEstado" text="Estado"
										prefWidth="100" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colEmpAcciones" text="Acciones"
										prefWidth="150" sortable="false"
										style="-fx-alignment: CENTER;" />
								</columns>
								<placeholder>
									<Label text="No hay empleados registrados"
										styleClass="card-hint" />
								</placeholder>
							</TableView>
						</VBox>
					</content>
				</Tab>

				<Tab fx:id="tabHorarios" text="Horarios">
					<content>
						<VBox spacing="8">
							<HBox spacing="10" alignment="CENTER_LEFT">
								<Region HBox.hgrow="ALWAYS" />
								<Button text="Nuevo turno"
									styleClass="toolbar-button, toolbar-blue"
									onAction="#handleNuevoTurno">
									<graphic>
										<SVGPath styleClass="toolbar-icon"
											content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
									</graphic>
								</Button>
								<Button text="Actualizar"
									styleClass="toolbar-button, toolbar-neutral"
									onAction="#handleActualizarTurnos">
									<graphic>
										<SVGPath styleClass="toolbar-icon"
											content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
									</graphic>
								</Button>
							</HBox>
							<TableView fx:id="tablaTurnos" VBox.vgrow="ALWAYS">
								<columnResizePolicy>
									<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
								</columnResizePolicy>
								<columns>
									<TableColumn fx:id="colTurOrden" text="Orden"
										prefWidth="70" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colTurNombre" text="Nombre"
										prefWidth="200" />
									<TableColumn fx:id="colTurEtiqueta" text="Etiqueta"
										prefWidth="80" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colTurHorario" text="Horario"
										prefWidth="160" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colTurSabado" text="Sábado"
										prefWidth="130" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colTurDomingo"
										text="Dom. o festivo" prefWidth="130"
										style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colTurCupos" text="Cupos"
										prefWidth="70" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colTurEstado" text="Estado"
										prefWidth="90" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colTurAcciones" text="Acciones"
										prefWidth="150" sortable="false"
										style="-fx-alignment: CENTER;" />
								</columns>
								<placeholder>
									<Label text="No hay turnos registrados"
										styleClass="card-hint" />
								</placeholder>
							</TableView>
						</VBox>
					</content>
				</Tab>

				<Tab fx:id="tabFestivos" text="Festivos">
					<content>
						<VBox spacing="8">
							<HBox spacing="10" alignment="CENTER_LEFT">
								<Label text="Año:" styleClass="field-caption" />
								<ComboBox fx:id="cmbAnioFestivos" prefWidth="110" />
								<Region HBox.hgrow="ALWAYS" />
								<Button text="Generar festivos del año"
									styleClass="toolbar-button, toolbar-neutral"
									onAction="#handleGenerarFestivos" />
								<Button text="Nuevo festivo"
									styleClass="toolbar-button, toolbar-blue"
									onAction="#handleNuevoFestivo">
									<graphic>
										<SVGPath styleClass="toolbar-icon"
											content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
									</graphic>
								</Button>
								<Button text="Actualizar"
									styleClass="toolbar-button, toolbar-neutral"
									onAction="#handleActualizarFestivos">
									<graphic>
										<SVGPath styleClass="toolbar-icon"
											content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
									</graphic>
								</Button>
							</HBox>
							<TableView fx:id="tablaFestivos" VBox.vgrow="ALWAYS">
								<columnResizePolicy>
									<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
								</columnResizePolicy>
								<columns>
									<TableColumn fx:id="colFesFecha" text="Fecha"
										prefWidth="120" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colFesDia" text="Día"
										prefWidth="120" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colFesNombre" text="Nombre"
										prefWidth="300" />
									<TableColumn fx:id="colFesAcciones" text="Acciones"
										prefWidth="150" sortable="false"
										style="-fx-alignment: CENTER;" />
								</columns>
								<placeholder>
									<Label text="No hay festivos cargados para este año"
										styleClass="card-hint" />
								</placeholder>
							</TableView>
						</VBox>
					</content>
				</Tab>

				<Tab fx:id="tabNovedades" text="Novedades">
					<content>
						<VBox spacing="8">
							<HBox spacing="10" alignment="CENTER_LEFT">
								<Button text="Anterior"
									styleClass="toolbar-button, toolbar-neutral"
									onAction="#handleNovAnterior" />
								<Label fx:id="lblMesNovedades" text=""
									styleClass="field-caption" />
								<Button text="Siguiente"
									styleClass="toolbar-button, toolbar-neutral"
									onAction="#handleNovSiguiente" />
								<Button text="Este mes"
									styleClass="toolbar-button, toolbar-neutral"
									onAction="#handleNovEsteMes" />
								<Region HBox.hgrow="ALWAYS" />
								<Button text="Nueva novedad"
									styleClass="toolbar-button, toolbar-blue"
									onAction="#handleNuevaNovedad">
									<graphic>
										<SVGPath styleClass="toolbar-icon"
											content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
									</graphic>
								</Button>
								<Button text="Actualizar"
									styleClass="toolbar-button, toolbar-neutral"
									onAction="#handleNovActualizar">
									<graphic>
										<SVGPath styleClass="toolbar-icon"
											content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
									</graphic>
								</Button>
							</HBox>
							<TableView fx:id="tablaNovedades" VBox.vgrow="ALWAYS">
								<columnResizePolicy>
									<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
								</columnResizePolicy>
								<columns>
									<TableColumn fx:id="colNovEmpleado" text="Empleado"
										prefWidth="140" />
									<TableColumn fx:id="colNovTipo" text="Tipo"
										prefWidth="110" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colNovDesde" text="Desde"
										prefWidth="95" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colNovHasta" text="Hasta"
										prefWidth="95" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colNovDias" text="Días"
										prefWidth="55" style="-fx-alignment: CENTER;" />
									<TableColumn fx:id="colNovSegunda"
										text="Segunda persona" prefWidth="130" />
									<TableColumn fx:id="colNovMotivo" text="Motivo"
										prefWidth="200" />
									<TableColumn fx:id="colNovRegistrado"
										text="Registrado por" prefWidth="110" />
									<TableColumn fx:id="colNovAcciones" text="Acciones"
										prefWidth="150" sortable="false"
										style="-fx-alignment: CENTER;" />
								</columns>
								<placeholder>
									<Label text="No hay novedades en este mes"
										styleClass="card-hint" />
								</placeholder>
							</TableView>
						</VBox>
					</content>
				</Tab>
			</tabs>
		</TabPane>
	</VBox>

</VBox>