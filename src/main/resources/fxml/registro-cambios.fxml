<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="12" styleClass="content, gasto-screen"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.misgastos.controller.RegistroCambiosController">

    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="table-card">

        <!-- Encabezado -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="panel-header">
            <Label styleClass="icon-circle">
                <graphic>
                    <SVGPath styleClass="icon-white"
                             content="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" />
                </graphic>
            </Label>
            <VBox spacing="2">
                <Label text="Registro de cambios" styleClass="panel-title" />
                <Label text="Quién editó, borró, restauró o eliminó un gasto, cuándo lo hizo y qué valor tenía."
                       styleClass="panel-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblResultados" text="" minWidth="-Infinity" styleClass="total-label" />
        </HBox>

        <!-- Filtros -->
        <HBox spacing="12" alignment="BOTTOM_LEFT">
            <VBox spacing="4">
                <Label text="Usuario" styleClass="form-label" />
                <ComboBox fx:id="cmbUsuario" prefWidth="170" />
            </VBox>
            <VBox spacing="4">
                <Label text="Acción" styleClass="form-label" />
                <ComboBox fx:id="cmbAccion" prefWidth="220" />
            </VBox>
            <VBox spacing="4">
                <Label text="Desde" styleClass="form-label" />
                <DatePicker fx:id="dpDesde" prefWidth="150" />
            </VBox>
            <VBox spacing="4">
                <Label text="Hasta" styleClass="form-label" />
                <DatePicker fx:id="dpHasta" prefWidth="150" />
            </VBox>
            <Button text="Buscar" onAction="#handleBuscar"
                    styleClass="toolbar-button, toolbar-blue" minWidth="-Infinity">
                <graphic>
                    <SVGPath styleClass="toolbar-icon"
                             content="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                </graphic>
            </Button>
            <Button text="Limpiar" onAction="#handleLimpiar"
                    styleClass="toolbar-button, toolbar-neutral" minWidth="-Infinity">
                <graphic>
                    <SVGPath styleClass="toolbar-icon"
                             content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                </graphic>
            </Button>
        </HBox>

        <!-- Tabla: las tres primeras columnas fijas, Detalle toma el resto -->
        <TableView fx:id="tablaRegistros" VBox.vgrow="ALWAYS"
                   style="-fx-fixed-cell-size: 34px;">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <Label text="No hay registros con esos filtros" />
            </placeholder>
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150" minWidth="150" maxWidth="150" />
                <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="100" minWidth="100" maxWidth="100" />
                <TableColumn fx:id="colAccion" text="Acción" prefWidth="150" minWidth="150" maxWidth="150" />
                <TableColumn fx:id="colDetalles" text="Detalle" prefWidth="600" minWidth="300" />
            </columns>
        </TableView>
    </VBox>

    <!-- Detalle completo de la fila elegida -->
    <VBox spacing="4" styleClass="form-card">
        <Label text="Detalle completo" styleClass="card-title" />
        <Label fx:id="lblDetalle" wrapText="true"
               text="Selecciona una fila para ver el detalle completo."
               styleClass="panel-subtitle" />
    </VBox>
</VBox>