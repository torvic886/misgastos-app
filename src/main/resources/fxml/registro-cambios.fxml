<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.misgastos.controller.RegistroCambiosController"
      spacing="16" styleClass="content">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <VBox spacing="2">
        <Label text="📜 Registro de cambios"
               style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1e293b;"/>
        <Label text="Quién editó, borró, restauró o eliminó un gasto, cuándo lo hizo y qué valor tenía."
               wrapText="true"
               style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
    </VBox>

    <!-- Filtros -->
    <VBox spacing="10" styleClass="form-card">
        <HBox spacing="14" alignment="BOTTOM_LEFT">
            <VBox spacing="4">
                <Label text="Usuario" style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
                <ComboBox fx:id="cmbUsuario" prefWidth="170"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Acción" style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
                <ComboBox fx:id="cmbAccion" prefWidth="220"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Desde" style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
                <DatePicker fx:id="dpDesde" prefWidth="150"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Hasta" style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
                <DatePicker fx:id="dpHasta" prefWidth="150"/>
            </VBox>
            <Button text="🔍 Buscar" onAction="#handleBuscar" styleClass="primary-button"/>
            <Button text="🔄 Limpiar" onAction="#handleLimpiar" styleClass="secondary-button"/>
        </HBox>
        <Label fx:id="lblResultados" wrapText="true"
               style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
    </VBox>

    <!-- Tabla -->
    <TableView fx:id="tablaRegistros" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="No hay registros con esos filtros"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150" minWidth="130"/>
            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="100" minWidth="80"/>
            <TableColumn fx:id="colAccion" text="Acción" prefWidth="170" minWidth="130"/>
            <TableColumn fx:id="colDetalles" text="Detalle" prefWidth="520"/>
        </columns>
    </TableView>

    <!-- Detalle completo de la fila elegida -->
    <VBox spacing="4" styleClass="form-card">
        <Label text="Detalle completo"
               style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1e293b;"/>
        <Label fx:id="lblDetalle" wrapText="true"
               text="Selecciona una fila para ver el detalle completo."
               style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
    </VBox>
</VBox>