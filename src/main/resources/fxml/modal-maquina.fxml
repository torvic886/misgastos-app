<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/17"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.misgastos.controller.ModalMaquinaController"
	styleClass="content, gasto-screen" prefWidth="450" prefHeight="640">

	<VBox spacing="10" styleClass="form-card" VBox.vgrow="ALWAYS">

		<!-- ============ ENCABEZADO ============ -->
		<HBox spacing="10" alignment="CENTER_LEFT"
			styleClass="panel-header">
			<Label styleClass="icon-circle">
				<graphic>
					<SVGPath styleClass="icon-white"
						content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM7.5 18c-.83 0-1.5-.67-1.5-1.5S6.67 15 7.5 15s1.5.67 1.5 1.5S8.33 18 7.5 18zm0-9C6.67 9 6 8.33 6 7.5S6.67 6 7.5 6 9 6.67 9 7.5 8.33 9 7.5 9zm4.5 4.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4.5 4.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm0-9c-.83 0-1.5-.67-1.5-1.5S15.67 6 16.5 6s1.5.67 1.5 1.5S17.33 9 16.5 9z" />
				</graphic>
			</Label>
			<VBox spacing="2">
				<Label fx:id="lblTitulo" text="Ingresar máquina"
					styleClass="panel-title" />
				<Label text="Completa los datos de la máquina"
					styleClass="panel-subtitle" />
			</VBox>
		</HBox>

		<!-- ============ FORMULARIO ============ -->
		<VBox spacing="4" styleClass="form-fields">

			<Label text="Código:" styleClass="form-label" />
			<TextField fx:id="txtCodigo" promptText="Ej: 9033"
				styleClass="search-field" />

			<Label text="Denominación:" styleClass="form-label, campo-sep" />
			<TextField fx:id="txtDenominacion" promptText="Ej: 1"
				styleClass="search-field" />

			<Label text="Nombre:" styleClass="form-label, campo-sep" />
			<TextField fx:id="txtNombre" promptText="Ej: Ainsworth"
				styleClass="search-field" />

			<Label text="Serial:" styleClass="form-label, campo-sep" />
			<TextField fx:id="txtSerial" promptText="Ej: 34123412"
				styleClass="search-field" />

			<Label text="Juego:" styleClass="form-label, campo-sep" />
			<TextField fx:id="txtJuego" promptText="Ej: MultiWin3"
				styleClass="search-field" />

			<Label text="Contador In:" styleClass="form-label, campo-sep" />
			<TextField fx:id="txtContadorIn"
				promptText="Ej: 92.480.000" styleClass="search-field" />

			<Label text="Contador Out:" styleClass="form-label, campo-sep" />
			<TextField fx:id="txtContadorOut"
				promptText="Ej: 65.015.100" styleClass="search-field" />

			<Label text="Contador Prem (Jackpot):"
				styleClass="form-label, campo-sep" />
			<TextField fx:id="txtContadorPrem"
				promptText="Ej: 1.018.443" styleClass="search-field" />
			<Label fx:id="lblNotaContadores"
				text="Ya tiene más lecturas: los contadores se corrigen en Contadores"
				wrapText="true" managed="false" visible="false"
				style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />

			<Label text="Diferencia (In - Out - Prem):"
				styleClass="form-label, campo-sep" />
			<Label fx:id="lblDiferencia" text="0"
				style="-fx-font-size: 14px; -fx-font-weight: bold;" />

			<Label text="Fecha de alta:" styleClass="form-label, campo-sep">
				<graphic>
					<SVGPath styleClass="icon-field"
						content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z" />
				</graphic>
			</Label>
			<DatePicker fx:id="dpFechaAlta"
				promptText="Seleccione fecha" maxWidth="Infinity" />
		</VBox>

		<!-- Mensaje de error -->
		<Label fx:id="lblError" text="" styleClass="error-message"
			managed="false" visible="false" wrapText="true" />

		<Region VBox.vgrow="ALWAYS" />

		<!-- ============ BOTONES ============ -->
		<HBox spacing="10" alignment="CENTER">
			<Button text="Cancelar" styleClass="btn-limpiar"
				onAction="#handleCancelar" HBox.hgrow="ALWAYS" maxWidth="Infinity">
				<graphic>
					<SVGPath styleClass="icon-slate"
						content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
				</graphic>
			</Button>
			<Button fx:id="btnGuardar" text="Guardar"
				styleClass="btn-guardar" onAction="#handleGuardar"
				HBox.hgrow="ALWAYS" maxWidth="Infinity">
				<graphic>
					<SVGPath styleClass="icon-white"
						content="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" />
				</graphic>
			</Button>
		</HBox>

	</VBox>
</VBox>