<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="12" style="-fx-padding: 0;" styleClass="content, gasto-screen"
	xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.misgastos.controller.GestionBilleterosController">

	<!-- ============ ENCABEZADO ============ -->
	<HBox spacing="10" alignment="CENTER_LEFT" styleClass="table-card">
		<HBox spacing="10" alignment="CENTER_LEFT" styleClass="panel-header">
			<Label styleClass="icon-circle">
				<graphic>
					<SVGPath styleClass="icon-white"
						content="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" />
				</graphic>
			</Label>
			<VBox spacing="2">
				<Label text="Gestión de Billeteros" styleClass="panel-title" />
				<Label text="Registra y consulta billeteros y premios"
					styleClass="panel-subtitle" />
			</VBox>
		</HBox>
		<Region HBox.hgrow="ALWAYS" />
		<Button fx:id="btnNuevo" text="Nuevo"
			styleClass="toolbar-button, toolbar-blue" onAction="#handleNuevo">
			<graphic>
				<SVGPath styleClass="toolbar-icon"
					content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
			</graphic>
		</Button>
		<Button fx:id="btnRefresh" text="Actualizar"
			styleClass="toolbar-button, toolbar-neutral"
			onAction="#handleRefresh">
			<graphic>
				<SVGPath styleClass="toolbar-icon"
					content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
			</graphic>
		</Button>
	</HBox>

	<!-- ============ FILTROS ============ -->
	<HBox spacing="10" alignment="CENTER_LEFT"
		styleClass="table-card, filter-bar">
		<Label text="Buscar:" styleClass="field-caption" />
		<TextField fx:id="txtBuscar" promptText="Buscar en la tabla..."
			prefWidth="230" styleClass="search-field" />

		<Separator orientation="VERTICAL" prefHeight="20" />

		<Label text="Desde:" styleClass="field-caption" />
		<DatePicker fx:id="dpFechaDesde" promptText="Fecha inicio"
			prefWidth="140" styleClass="date-picker" />

		<Label text="Hasta:" styleClass="field-caption" />
		<DatePicker fx:id="dpFechaHasta" promptText="Fecha fin"
			prefWidth="140" styleClass="date-picker" />

		<Button text="Buscar" styleClass="toolbar-button, toolbar-blue"
			onAction="#handleBuscar">
			<graphic>
				<SVGPath styleClass="toolbar-icon"
					content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
			</graphic>
		</Button>
		<Button text="Limpiar" styleClass="toolbar-button, toolbar-neutral"
			onAction="#handleLimpiarFiltros">
			<graphic>
				<SVGPath styleClass="toolbar-icon"
					content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
			</graphic>
		</Button>
	</HBox>

	<!-- ============ TABLA ============ -->
	<VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="table-card">

		<TableView fx:id="tablaBilleteros" VBox.vgrow="ALWAYS"
			style="-fx-fixed-cell-size: 34px;">
			<columnResizePolicy>
				<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
			</columnResizePolicy>
			<columns>
				<TableColumn fx:id="colFecha" text="Fecha" prefWidth="130"
					style="-fx-alignment: CENTER;" />
				<TableColumn fx:id="colBilletero" text="Billetero"
					prefWidth="180" style="-fx-alignment: CENTER_RIGHT;" />
				<TableColumn fx:id="colPremios" text="Premios"
					prefWidth="180" style="-fx-alignment: CENTER_RIGHT;" />
				<TableColumn fx:id="colDiferencia" text="Diferencia"
					prefWidth="180" style="-fx-alignment: CENTER_RIGHT;" />
				<TableColumn fx:id="colAcciones" text="Acciones"
					prefWidth="120" style="-fx-alignment: CENTER;" />
			</columns>
			<placeholder>
				<VBox alignment="CENTER" spacing="8">
					<SVGPath styleClass="icon-empty"
						content="M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" />
					<Label text="No hay registros para mostrar"
						styleClass="card-hint" />
				</VBox>
			</placeholder>
		</TableView>

		<!-- Paginación y conteo -->
		<HBox spacing="10" alignment="CENTER_LEFT" styleClass="pager-bar">
			<Label fx:id="lblTotalRegistros" text="Total registros: 0"
				styleClass="pager-label" />
			<Region HBox.hgrow="ALWAYS" />
			<Button fx:id="btnAnterior" text="◀" disable="true"
				styleClass="pager-button" />
			<Label fx:id="lblPagina" text="Página 1 de 1"
				styleClass="pager-label" />
			<Button fx:id="btnSiguiente" text="▶" disable="true"
				styleClass="pager-button" />
		</HBox>
	</VBox>

	<!-- ============ RESUMEN GENERAL ============ -->
	<HBox spacing="12" alignment="CENTER_LEFT" styleClass="table-card, resumen-card">
		<VBox spacing="2" styleClass="res-tile, res-blue">
			<Label text="Total Billetero" styleClass="res-caption" />
			<Label fx:id="lblTotalBilletero" text="0"
				styleClass="res-value, res-value-blue" />
		</VBox>
		<VBox spacing="2" styleClass="res-tile, res-purple">
			<Label text="Total Premios" styleClass="res-caption" />
			<Label fx:id="lblTotalPremios" text="0"
				styleClass="res-value, res-value-purple" />
		</VBox>
		<Region HBox.hgrow="ALWAYS" />
		<HBox alignment="CENTER_LEFT" spacing="10" styleClass="total-bar">
			<SVGPath styleClass="icon-green"
				content="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" />
			<Label text="Diferencia Neta" styleClass="total-label" />
			<Label fx:id="lblDiferenciaNeta" text="0"
				styleClass="total-value" />
		</HBox>
	</HBox>

</VBox>
