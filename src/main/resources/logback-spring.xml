<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Carpeta de logs: %USERPROFILE%\MisGastos\logs (junto a la base de datos y los respaldos) -->
    <property name="LOG_DIR" value="${user.home}/MisGastos/logs"/>

    <!-- Formato fijo: la pantalla "Diagnóstico y registros" lo va a leer, no lo cambies sin avisar -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n"/>

    <!-- Archivo principal con rotación y limpieza automática -->
    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/misgastos.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Al cerrar un archivo (10 MB o medianoche) se comprime: la extensión .gz lo activa -->
            <fileNamePattern>${LOG_DIR}/misgastos-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>80MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- Solo lo importante: lo de Spring, Hibernate y Hikari se muestra únicamente si es WARN o ERROR.
         Se deja en INFO solo SpringApplication: versión de Java, perfil activo y "Started" (arranque correcto). -->
    <logger name="org.springframework.boot.SpringApplication" level="INFO"/>

    <!-- DESARROLLO (Maven / IDE): detalle de tu código y también en la consola -->
    <springProfile name="dev">
        <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
				<charset>UTF-8</charset>
            </encoder>
        </appender>
        <logger name="com.misgastos" level="DEBUG"/>
        <root level="WARN">
            <appender-ref ref="CONSOLA"/>
            <appender-ref ref="ARCHIVO"/>
        </root>
    </springProfile>

    <!-- PRODUCCIÓN (programa instalado): solo archivo, sin consola -->
    <springProfile name="!dev">
        <logger name="com.misgastos" level="INFO"/>
        <root level="WARN">
            <appender-ref ref="ARCHIVO"/>
        </root>
    </springProfile>

</configuration>